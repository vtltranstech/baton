# Hooks and scripts run under sh/bash on every OS, including Git Bash on Windows: a CRLF checkout breaks them.
* text=auto
hooks/run-hook text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.jar binary
*.png binary
