+import { useEffect, useState } from "react";
+
+export function FeeTotal({ accountRef }: { accountRef: string }) {
+  const [total, setTotal] = useState("");
+  useEffect(() => {
+    fetch(`/api/v1/fees/${accountRef}`)
+      .then((response) => response.text())
+      .then(setTotal);
+  }, [accountRef]);
+  return <p>{total}</p>;
+}
