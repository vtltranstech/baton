{
  "description": "baton gates: main and environment protection, story commit scope, story state gate, weights protection, doc style lint, read log",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook\" protect_main.py", "shell": "bash", "onFailure": "block", "timeout": 30},
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook\" protect_env.py", "shell": "bash", "onFailure": "block", "timeout": 30},
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook\" commit_scope.py", "shell": "bash", "onFailure": "block", "timeout": 30}
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook\" state_gate.py", "shell": "bash", "onFailure": "block", "timeout": 30}
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook\" protect_weights.py", "shell": "bash", "onFailure": "block", "timeout": 30}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook\" doc_lint.py", "shell": "bash", "timeout": 30}
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook\" read_log.py", "shell": "bash", "timeout": 10}
        ]
      }
    ]
  }
}
