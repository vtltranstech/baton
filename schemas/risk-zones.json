{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "risk-zones",
  "type": "object",
  "required": [
    "zones"
  ],
  "properties": {
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "paths",
          "cap"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          },
          "cap": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    }
  }
}